# Copy to .env and fill in. .env is gitignored.
# The Kaggle token does NOT belong here — it lives at ~/.kaggle/access_token
# (machine-level, only needed to download the snapshot).

# --- Local models (Ollama) ---
OLLAMA_HOST=http://localhost:11434

# --- OpenAI (closed comparison model) ---
OPENAI_API_KEY=

# --- Observability ---
# Phoenix and Langfuse run from infra/docker-compose.yml.
# Arize Phoenix (local; no auth by default)
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006

# Langfuse (self-hosted). Keys must match infra/.env, where headless init
# creates them on first start.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3100

# LangSmith (cloud, free tier) — traces leave this machine
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=soapy-referee

# --- Run labelling ---
# dev (default) for quick and debugging runs; eval for runs whose numbers count.
# Shown as the trace environment in the tools and written to the run record.
SREF_ENV=dev

# --- Data snapshot ---
# Frozen, read-only. Its checksum lives in a committed manifest, not here.
NBA_SQLITE_PATH=./data/nba.sqlite
