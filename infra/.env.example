# Secrets for infra/docker-compose.yml. Copy to infra/.env (gitignored) and
# fill every value; compose refuses to start with any left blank.
# Generate each with: openssl rand -hex 32

# Langfuse internals
POSTGRES_PASSWORD=
CLICKHOUSE_PASSWORD=
MINIO_ROOT_PASSWORD=
REDIS_AUTH=
SALT=
NEXTAUTH_SECRET=
ENCRYPTION_KEY=

# Langfuse headless init: the project's API keys and the UI login, created on
# first start. Keys must keep their prefixes (pk-lf-..., sk-lf-...) and match
# LANGFUSE_PUBLIC_KEY / LANGFUSE_SECRET_KEY in the root .env.
LANGFUSE_PUBLIC_KEY=pk-lf-
LANGFUSE_SECRET_KEY=sk-lf-
LANGFUSE_INIT_USER_EMAIL=admin@sref.local
LANGFUSE_INIT_USER_PASSWORD=
